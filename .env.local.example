# Optional: use locally built full corpora (gitignored output from corpus:build-*)
# Copy paths printed by the build scripts, or use these defaults after building:
#
# WH40K_CORPUS_PATH=src/data/local/wh40k-core-corpus.json
# STARCRAFT_CORPUS_PATH=src/data/local/starcraft-core-corpus.json

# Optional: Supabase auth + synced favorites (leave unset for guest-only local mode)
# Create a project at https://supabase.com, run supabase/migrations/001_favorites.sql,
# enable Email auth, then paste Project URL and anon public key:
#
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
